# FalkorDB Graph Database Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# LUNA Language Model Configuration
# Provider: 'ollama' | 'openai_compatible' | 'anthropic' | 'gemini' (default: ollama)
LUNA_LLM_PROVIDER=ollama

# Model name for graph extraction, mapping, planning, tool loops, and answer synthesis
# Examples:
#   Ollama: 'qwen2.5:7b', 'llama3.1:8b', 'mistral', 'qwen3.5:4b'
#   OpenAI Compatible: 'gpt-4o', 'gpt-4o-mini', 'deepseek-chat'
#   Anthropic: 'claude-3-5-sonnet-20241022', 'claude-3-5-haiku-20241022'
#   Gemini: 'gemini-1.5-pro', 'gemini-1.5-flash', 'gemini-2.0-flash'
LUNA_LLM_MODEL=qwen2.5:7b

# Base URL for API calls
# For Ollama: default is 'http://localhost:11434'
# For OpenAI Compatible: e.g. 'https://api.openai.com/v1' or custom proxy URL
LUNA_LLM_BASE_URL=http://localhost:11434

# API key for remote providers (leave blank for local Ollama)
# Note: Keys are read server-side only; never logged, returned, or stored in graphs.
LUNA_LLM_API_KEY=

# Standard provider keys (can also be read by provider SDKs)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Request timeout in seconds for LLM completions (default: 90)
LUNA_LLM_TIMEOUT_S=90

# Maximum output tokens generated per completion (default: 4096)
LUNA_LLM_MAX_OUTPUT_TOKENS=4096

# --- Example: OmniRoute (OpenAI-compatible gateway on this machine) ---
# LUNA_LLM_PROVIDER=openai_compatible
# LUNA_LLM_BASE_URL=http://localhost:20128/v1
# LUNA_LLM_MODEL=<a model or combo name from GET /v1/models>
# LUNA_LLM_API_KEY=<your OmniRoute key>
# Requests set stream=false, so gateways that stream by default still return plain JSON.
